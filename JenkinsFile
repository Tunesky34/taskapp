pipeline{
    agent any
    stages{
        stage(checkout){
            steps(
                checkout scm
            )
        }
        stage(Install Dependencies){
            steps(
                sh 'npm install'
            )
        }
        stage(Build){
            steps(
                sh 'npm run build'
            )
        }
        stage(Test){
            steps(
                sh 'npm test'
            )
        }
        stage(Deploy){
            steps(
                sh 'npm run deploy'
            )
        }
    }
    Post{
        success{
            echo 'This will run only if successful'
        }
        failure{
            echo 'This will run only if failed'
        }
    }
}